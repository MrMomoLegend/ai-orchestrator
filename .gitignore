# ---------------------------------------------------------------------------
# CM3070 — Locally-Deployed AI Orchestration System
#
# Rule of thumb: if a file can be regenerated by running a script, it does not
# belong in the repository. Everything reported in Chapter 5 is reproducible
# from the scripts in eval/ and the CSVs in results/, which ARE tracked.
# ---------------------------------------------------------------------------

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/
ENV/

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-error.log*
package-lock.json.bak

# --- Vector store ----------------------------------------------------------
# ~35 MB. Fully regenerable: python ingest.py
# Both collections (documents_sentence, documents_fixed) rebuild in one pass.
chroma_db/

# --- ASR evaluation assets -------------------------------------------------
# Raw recordings. Kept off the repo for the same reason the report gives for
# keeping them off the network: they contain a second person's voice, recorded
# under a consent that covers evaluation of this project only.
asr_eval/audio/
asr_eval/audio_16k/

# Vosk acoustic model, ~69 MB. Redownload from:
# https://alphacephei.com/vosk/models  (vosk-model-small-en-us-0.15)
asr_eval/models/

# NOTE: asr_eval/references.csv and asr_eval/results/ ARE tracked — they are
# the reference transcripts and the measured WER behind Section 5.6.

# --- Report build ----------------------------------------------------------
# The built .docx and .pdf ARE tracked: they are the assessed deliverable and
# the submitted artefact should be in the history. Only the scratch is ignored.
report/node_modules/
report/*.tmp
report/pg-*.jpg
report/~$*
.~lock.*#

# --- Working scratch -------------------------------------------------------
_to_delete/
scratch/
tmp/
*.bak
*.orig

# --- Editors and OS --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ---------------------------------------------------------------
# Nothing in this project needs a key — it makes no external API calls — but
# this guards against a stray .env if that ever changes.
.env
.env.*
*.key
*.pem
